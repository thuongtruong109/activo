# Required: exactly 8 random printable ASCII characters, without spaces.
# Classic VNC only supports 8 bytes; use separate strong authentication at the TLS proxy.
# An empty value deliberately prevents startup. Do not commit your real .env.
# Use Compose .env single quoting for values containing $ to avoid interpolation.
ACTIVO_VNC_PASSWORD=
ACTIVO_PORT=6080
ACTIVO_SCREEN=1440x900x24
