# Include inside the host Nginx `http {}` context. This is NOT an automatic deploy.
# Replace the hostname/origin and provide trusted TLS certificates + strong HTTP auth.
# Loopback listener deliberately remains private; use a VPN/SSH tunnel for access.
map $http_upgrade $activo_connection_upgrade {
    default upgrade;
    '' close;
}
map $http_origin $activo_origin_allowed {
    default 0;
    "https://license-admin.example.invalid:8443" 1;
}

server {
    listen 127.0.0.1:8443 ssl;
    server_name license-admin.example.invalid;
    server_tokens off;
    ssl_certificate /etc/nginx/activo/tls.fullchain.pem;
    ssl_certificate_key /etc/nginx/activo/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    # Protect BOTH HTML assets and WebSocket upgrades with a separate strong password.
    auth_basic "Private License Admin desktop";
    auth_basic_user_file /etc/nginx/activo/proxy.htpasswd;

    location = /websockify {
        if ($activo_origin_allowed = 0) { return 403; }
        proxy_pass http://127.0.0.1:6080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $activo_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }
    location / {
        proxy_pass http://127.0.0.1:6080;
        proxy_http_version 1.1;
        # Do not allow a different path to bypass the WebSocket Origin check.
        proxy_set_header Upgrade "";
        proxy_set_header Connection "";
    }
}
